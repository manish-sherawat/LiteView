<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Storage permissions for reading documents -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Android 13+ granular media permissions -->
    <!-- Removed READ_MEDIA_IMAGES and READ_MEDIA_VIDEO as only documents are read -->

    <!--
        MANAGE_EXTERNAL_STORAGE — Android 11+ (API 30+) — REQUIRED for core functionality.

        Justification: NexusDocsViewer is a document manager that must enumerate, open,
        rename, move, and soft-delete files across ALL directories of external storage
        (Downloads, Documents, arbitrary folders chosen by the user). The SAF
        (Storage Access Framework) cannot satisfy this use-case because:
          1. SAF requires the user to pick every folder individually via a system picker,
             making automated "scan all documents" impossible without granting hundreds of
             individual trees.
          2. MediaStore does not expose files in app-private dirs or non-standard folder
             layouts used by many file managers.
          3. The Recycle Bin feature moves files to an internal quarantine directory and
             restores them to their original location — impossible without full-path access.

        Play Store Compliance:
          - This app MUST submit a "Permissions Declaration" form in the Play Console
            (Policy → App Content → Sensitive Permissions) each time it is submitted.
          - Declaration category: "File Manager" or "Backup & Restore" (whichever fits best).
          - The tools:ignore="ScopedStorage" below suppresses the Android Studio lint
            warning ONLY — it does NOT replace the Play Console declaration form.

        READ_EXTERNAL_STORAGE (maxSdkVersion=32 below) covers API 29–32 (Android 10–12L).
        On API 33+ (Android 13+), no additional permission is required beyond this one
        because MANAGE_EXTERNAL_STORAGE implicitly grants read access.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    
    <!-- Camera for scanning documents -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Haptic feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Updater Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".NexusDocsApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NexusDocsViewer.Splash"
        android:hardwareAccelerated="true"
        tools:targetApi="35">

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.NexusDocsViewer">

            <!-- Launcher intent -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- PDF intent filter — open PDFs from any app -->
            <intent-filter android:priority="1" tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <!-- DOCX intent filter -->
            <intent-filter android:priority="1" tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
            </intent-filter>

            <!-- DOC intent filter -->
            <intent-filter android:priority="1" tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/msword" />
            </intent-filter>

            <!-- XLSX intent filter -->
            <intent-filter android:priority="1" tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.ms-excel" />
            </intent-filter>

            <!-- PPTX and PPT intent filters -->
            <intent-filter android:priority="1" tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="application/vnd.ms-powerpoint" />
            </intent-filter>



            <!-- TXT & Text intent filter -->
            <intent-filter android:priority="1" tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/tab-separated-values" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="text/html" />
                <data android:mimeType="text/css" />
                <data android:mimeType="text/javascript" />
                <data android:mimeType="text/x-log" />
                <data android:mimeType="text/yaml" />
                <data android:mimeType="text/x-yaml" />
            </intent-filter>

            <!-- JSON & XML Application MIME types -->
            <intent-filter android:priority="1" tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/geo+json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="application/yaml" />
                <data android:mimeType="application/toml" />
                <data android:mimeType="application/javascript" />
                <data android:mimeType="image/svg+xml" />
            </intent-filter>

            <!-- File URI intent filter — local file manager support -->
            <intent-filter android:priority="1" tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- Content URI intent filter — SAF and cloud app support -->
            <intent-filter android:priority="1" tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- Share intent filter — handle shared files from other apps -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- File Provider for temporary cache files -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

    </application>

</manifest>
