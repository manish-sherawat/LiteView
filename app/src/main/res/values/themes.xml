<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base app theme — transparent splash background so Compose draws immediately -->
    <style name="Theme.NexusDocsViewer" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!-- Splash theme — uses Android 12+ Splash Screen API -->
    <style name="Theme.NexusDocsViewer.Splash" parent="Theme.SplashScreen">
        <!-- Splash icon background -->
        <item name="windowSplashScreenBackground">#F4F6FA</item>
        <!-- Animated icon or static icon -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <!-- Duration for animated icon (API 33+) -->
        <item name="windowSplashScreenAnimationDuration">500</item>
        <!-- Post-splash theme transition -->
        <item name="postSplashScreenTheme">@style/Theme.NexusDocsViewer</item>
    </style>
</resources>
